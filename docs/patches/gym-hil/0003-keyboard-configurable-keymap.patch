+    @classmethod
+    def _load_keymap(cls, config_path=None):
+        """키 배치를 읽는다. 인자 > GYM_HIL_KEYMAP 환경변수 > 내장 기본값 순."""
+        import os
+
+        keymap = dict(cls.DEFAULT_KEYMAP)
+        path = config_path or os.environ.get("GYM_HIL_KEYMAP")
+        if not path:
+            return keymap
+        try:
+            with open(path) as f:
+                user = json.load(f)
+        except FileNotFoundError:
+            logging.warning(f"키맵 파일을 찾지 못했다: {path}. 기본 배치를 쓴다.")
+            return keymap
+        except Exception as exc:  # noqa: BLE001
+            logging.warning(f"키맵 파일을 읽지 못했다({path}): {exc}. 기본 배치를 쓴다.")
+            return keymap
+
+        unknown = [k for k in user if k not in keymap]
+        if unknown:
+            logging.warning(f"키맵에서 모르는 항목은 무시한다: {unknown}")
+        keymap.update({k: v for k, v in user.items() if k in keymap})
+
+        seen = {}
+        for action, key in keymap.items():
+            if key in seen:
+                logging.warning(f"키 '{key}' 가 '{seen[key]}' 와 '{action}' 에 겹쳐 있다. 하나만 동작한다.")
+            seen[key] = action
+        return keymap
+
+    @staticmethod
+    def _resolve(name):
+        """키 이름 하나를 pynput 키 객체 목록으로 바꾼다(좌/우 구분 없는 변형 포함)."""
+        from pynput import keyboard
+
+        aliases = {
+            "shift_l": ["shift_l", "shift"],
+            "ctrl_l": ["ctrl_l", "ctrl"],
+            "alt_l": ["alt_l", "alt"],
+            "shift_r": ["shift_r"],
+            "ctrl_r": ["ctrl_r"],
+            "alt_r": ["alt_r", "alt_gr"],
+        }
+        out = []
+        for candidate in aliases.get(name, [name]):
+            key = getattr(keyboard.Key, candidate, None)
+            if key is not None:
+                out.append(key)
+        return out
 
