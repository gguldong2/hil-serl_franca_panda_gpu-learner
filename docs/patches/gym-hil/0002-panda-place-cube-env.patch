+#!/usr/bin/env python
+"""조작자용 화면을 파일로 흘려보내는 래퍼 (+ 화면 위 정보 표시, 일시정지).
+
+MuJoCo 의 패시브 뷰어 창(GLFW)은 X 서버의 GLX 를 쓴다. VNC(Xtigervnc) 위에서는
+GLX 가 llvmpipe(소프트웨어)로 잡혀서 스텝당 ~859 ms 가 걸린다. EGL 오프스크린은
+GPU 를 쓰므로 같은 장면이 ~23 ms 다. 그래서 EGL 로 한 장 더 렌더해 JPEG 로 저장하고,
+대시보드(scripts/progress_dashboard.py)가 그 파일을 MJPEG 로 브라우저에 흘려준다.
+
+화면 위에 얹는 것:
+  - 왼쪽 위: 스텝 · 에피소드 · 성공률 · 경과 시간
+  - 개입 중에는 **빨간 테두리 + "● 개입 중 (REC)"** 배지. 지금 누가 조종 중인지 한눈에 보인다.
+  - 일시정지 중에는 노란 테두리 + "⏸ 일시정지"
+
+환경변수:
+  HIL_VIEW_STREAM   저장 경로 (예: /dev/shm/hil_view.jpg). 없으면 이 래퍼는 붙지 않는다.
+  HIL_VIEW_SIZE     한 칸의 픽셀 크기 (기본 512)
+  HIL_VIEW_CAMERAS  쉼표로 구분한 카메라 이름 (기본 "front")
+  HIL_VIEW_EVERY    몇 스텝마다 저장할지 (기본 1)
+  HIL_VIEW_HUD      0 이면 글자/테두리를 얹지 않는다 (기본 1)
+  HIL_PAUSE_FILE    이 파일이 있으면 시뮬레이터가 멈춘다 (기본 /dev/shm/hil_pause)
+"""
+
+import logging
+import os
+import tempfile
+import time
+
+import gymnasium as gym
+import mujoco
+import numpy as np
+
+_FONT_CANDIDATES = (
+    "/usr/share/fonts/truetype/nanum/NanumGothicCodingBold.ttf",
+    "/usr/share/fonts/truetype/nanum/NanumGothicCoding.ttf",
+    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
+    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
+)
+
+
+def _load_font(size):
+    from PIL import ImageFont
+
+    for path in _FONT_CANDIDATES:
+        if os.path.exists(path):
+            try:
+                return ImageFont.truetype(path, size)
+            except OSError:
+                continue
+    try:
+        return ImageFont.load_default()
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def _load_history(run_dir):
+    """이 런이 지금까지 남긴 기록을 읽어 (에피소드수, 성공수, 최근20판, 누적스텝) 을 돌려준다.
+
+    actor 프로세스는 재시작할 때마다 자기 카운터를 0 부터 세므로, 화면에 "1번째 에피소드"
+    가 다시 떠서 이어서 하는 건지 새로 하는 건지 알 수 없었다. learner 가 남기는
+    learner_metrics.jsonl 이 런 전체의 원본 기록이므로 그것을 읽어 이어받는다.
+    """
+    import json as _json
+
+    path = os.path.join(run_dir, "logs", "learner_metrics.jsonl")
+    ep = succ = steps = 0
+    recent = []
+    prev = base = 0
+    try:
+        with open(path, errors="replace") as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    r = _json.loads(line)
+                except ValueError:
+                    continue
+                if r.get("kind") != "interaction":
+                    continue
+                rew = r.get("Episodic reward")
+                if not isinstance(rew, (int, float)):
+                    continue
+                ok = 1 if float(rew) > 0.5 else 0
+                ep += 1
+                succ += ok
+                recent.append(ok)
+                if len(recent) > 20:
+                    recent.pop(0)
+                v = r.get("Interaction step")
+                if isinstance(v, (int, float)):
+                    v = int(v)
+                    if v < prev:
+                        base += prev
+                    prev = v
+                    steps = base + v
+    except OSError:
+        return 0, 0, [], 0
+    return ep, succ, recent, steps
+
+
+def _elapsed_path(run_dir):
+    return os.path.join(run_dir, "elapsed.json")
+
+
+def _elapsed_from_log(run_dir, max_gap=600.0):
+    """learner 가 남긴 기록에서 실제로 돌아간 시간을 추정한다.
+
+    에피소드 기록마다 시각이 들어 있으므로, 연속한 기록 사이 간격 중 max_gap 보다
+    짧은 것만 더하면 "실제로 돌던 시간" 이 된다(긴 간격 = 멈춰 있던 구간).
+
+    elapsed.json 보다 이쪽이 믿을 만한 경우가 있다 — actor 를 다른 실험 이름으로 띄우면
+    그 동안 elapsed.json 이 멈춰 있기 때문이다. 그래서 시작할 때 둘 중 큰 값을 쓴다.
+    """
+    import json as _json
+
+    path = os.path.join(run_dir, "logs", "learner_metrics.jsonl")
+    prev = None
+    total = 0.0
+    try:
+        with open(path, errors="replace") as f:
+            for line in f:
+                if '"interaction"' not in line:
+                    continue
+                try:
+                    r = _json.loads(line)
+                except ValueError:
+                    continue
+                if r.get("kind") != "interaction":
+                    continue
+                t = r.get("time")
+                if not isinstance(t, (int, float)):
+                    continue
+                if prev is not None:
+                    gap = t - prev
+                    if 0 < gap < max_gap:
+                        total += gap
+                prev = t
+    except OSError:
+        return 0.0
+    return total
+
+
+def _load_elapsed(run_dir):
+    """이 런이 지금까지 실제로 돌았던 초. 없으면 0."""
+    import json as _json
+
+    try:
+        with open(_elapsed_path(run_dir)) as f:
+            v = _json.load(f).get("seconds", 0)
+        return float(v) if isinstance(v, (int, float)) else 0.0
+    except (OSError, ValueError):
+        return 0.0
+
+
+def _save_elapsed(run_dir, seconds):
+    """원자적으로 갱신한다. 로그에서 공백을 추정하는 것보다 정확하다.
+
+    이미 적힌 값이 더 크면 그대로 둔다 — 시작할 때 읽은 뒤 누가 더 큰 값으로 채워 넣었거나
+    (기록에서 역산해 보정하는 경우) 다른 프로세스가 앞서 있을 수 있기 때문이다.
+    경과 시간은 줄어들 수 없는 값이므로 max 가 항상 옳다.
+    """
+    import json as _json
+
+    seconds = max(seconds, _load_elapsed(run_dir))
+    try:
+        d = os.path.dirname(_elapsed_path(run_dir)) or "."
+        os.makedirs(d, exist_ok=True)
+        fd, tmp = tempfile.mkstemp(dir=d, suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            _json.dump({"seconds": round(seconds, 1)}, f)
+        os.replace(tmp, _elapsed_path(run_dir))
+    except OSError:
+        pass
+
+
+class ViewStreamWrapper(gym.Wrapper):
+    """매 스텝 조작자용 화면을 렌더해 JPEG 파일로 원자적으로 교체 저장한다."""
+
+    def __init__(self, env, path, size=512, cameras=("front",), every=1, quality=70,
+                 hud=True, pause_file="/dev/shm/hil_pause"):
+        super().__init__(env)
+        self.path = path
+        self.every = max(1, int(every))
+        self.quality = int(quality)
+        self.hud = bool(hud)
+        self.pause_file = pause_file
+        self._n = 0
+        self._renderer = None
+        self._cameras = list(cameras)
+        self._size = int(size)
+
+        # HUD 상태
+        self._t0 = time.time()
+        self._paused_for = 0.0
+        self._steps = 0            # 누적 스텝 = actor 의 상호작용 스텝
+        self._ep = 0               # 지금까지 끝난 에피소드 수
+        self._ep_step = 0
+        self._succ = 0
+        self._last_reward = 0.0
+        self._recent = []          # 최근 에피소드 성공 여부
+        self._intervening = False
+        self._interv_steps = 0
+        self._paused = False
+        self._font = None
+        self._font_small = None
+        self._carried = 0          # 이어받은 에피소드 수 (화면에 표시용)
+
+        # HIL_RUN_DIR 이 주어지면 그 런의 기록을 이어받는다. 없으면 0 부터 센다
+        # (연습·녹화처럼 런에 속하지 않는 실행).
+        run_dir = os.environ.get("HIL_RUN_DIR")
+        self._run_dir = run_dir
+        self._elapsed_base = 0.0
+        self._elapsed_saved_at = 0.0
+        if run_dir:
+            _file = _load_elapsed(run_dir)
+            _log = _elapsed_from_log(run_dir)
+            self._elapsed_base = max(_file, _log)
+            if self._elapsed_base:
+                src = "기록" if _log > _file else "파일"
+                logging.info(
+                    f"[view-stream] 경과 시간을 이어받는다: {self._elapsed_base/3600:.2f} 시간 "
+                    f"(파일 {_file/3600:.2f}h · 기록 {_log/3600:.2f}h -> {src} 기준)"
+                )
+                if _log > _file:
+                    _save_elapsed(run_dir, self._elapsed_base)
+            ep, succ, recent, steps = _load_history(run_dir)
+            if ep:
+                self._ep, self._succ, self._recent, self._steps = ep, succ, recent, steps
+                self._carried = ep
+                logging.info(
+                    f"[view-stream] 이 런의 기록을 이어받는다: {ep}판 · 성공 {succ} · 누적 {steps:,} 스텝"
+                )
+            else:
+                logging.info("[view-stream] 이 런은 기록이 없다. 0 부터 센다(새 실험).")
+
+        try:
+            from PIL import Image  # noqa: F401
+        except ImportError:
+            logging.warning("[view-stream] Pillow 가 없어 화면 스트림을 끈다.")
+            return
+
+        base = self.env.unwrapped
+        # MujocoGymEnv.__init__ 이 모델의 오프스크린 버퍼 한도를 render_spec(128x128)으로
+        # 덮어쓴다. 조작자용 화면은 그보다 크게 뽑아야 하므로 여기서 한도를 올린다.
+        try:
+            g = base.model.vis.global_
+            g.offwidth = max(int(g.offwidth), self._size)
+            g.offheight = max(int(g.offheight), self._size)
+        except Exception as exc:  # noqa: BLE001
+            logging.warning(f"[view-stream] 오프스크린 버퍼 한도를 올리지 못했다: {exc}")
+        try:
+            self._renderer = mujoco.Renderer(base.model, self._size, self._size)
+        except Exception as exc:  # noqa: BLE001
+            logging.warning(f"[view-stream] 렌더러를 만들지 못해 화면 스트림을 끈다: {exc}")
+            self._renderer = None
+            return
+
+        valid = []
+        for name in self._cameras:
+            if mujoco.mj_name2id(base.model, mujoco.mjtObj.mjOBJ_CAMERA, name) >= 0:
+                valid.append(name)
+            else:
+                logging.warning(f"[view-stream] 카메라 '{name}' 가 없어 건너뛴다.")
+        self._cameras = valid or ["front"]
+
+        if self.hud:
+            self._font = _load_font(19)
+            self._font_small = _load_font(15)
+            if self._font is None:
+                logging.warning("[view-stream] 글꼴을 찾지 못해 화면 표시를 끈다.")
+                self.hud = False
+
+        os.makedirs(os.path.dirname(os.path.abspath(self.path)) or ".", exist_ok=True)
+        logging.info(
+            f"[view-stream] {self.path} 로 {'+'.join(self._cameras)} "
+            f"({self._size}px, {self.every} 스텝마다) 내보낸다. "
+            f"화면표시={'켬' if self.hud else '끔'} 일시정지파일={self.pause_file}"
+        )
+
+    # ------------------------------------------------------------------ HUD
+
+    def _elapsed(self):
+        s = int(self._elapsed_base + (time.time() - self._t0))
+        h, m, sec = s // 3600, (s % 3600) // 60, s % 60
+        return f"{h}:{m:02d}:{sec:02d}" if h else f"{m}:{sec:02d}"
+
+    def _hud_lines(self):
+        n = len(self._recent)
+        recent = f"최근{n}판 {100 * sum(self._recent) // n}%" if n else "최근 - "
+        overall = f"{self._succ}/{self._ep}" if self._ep else "0/0"
+        rate = f" ({100 * self._succ // self._ep}%)" if self._ep else ""
+        iv = f" · 개입 {100 * self._interv_steps // max(self._steps, 1)}%"
+        tag = f" (이어서, {self._carried}판부터)" if self._carried else " (새 실험)"
+        return [
+            f"전체 {self._steps:,} 스텝 · {self._ep + 1}번째 에피소드 {self._ep_step} 스텝째{tag}",
+            f"성공 {overall}{rate} · {recent}{iv} · 경과 {self._elapsed()}",
+        ]
+
+    def _draw_hud(self, img):
+        from PIL import Image, ImageDraw
+
+        pil = Image.fromarray(img).convert("RGB")
+        d = ImageDraw.Draw(pil, "RGBA")
+        w, h = pil.size
+
+        lines = self._hud_lines()
+        box_h = 8 + 23 * len(lines)
+        d.rectangle([0, 0, w, box_h], fill=(0, 0, 0, 165))
+        for i, t in enumerate(lines):
+            d.text((10, 4 + 23 * i), t, font=self._font, fill=(255, 255, 255, 240))
+
+        # 상태 배지 + 테두리
+        if self._paused:
+            color, label = (250, 200, 40), "|| 일시정지"
+        elif self._intervening:
+            color, label = (235, 55, 55), "● 개입 중 (REC)"
+        else:
+            color, label = None, None
+
+        if color is not None:
+            bw = 7
+            for k in range(bw):
+                d.rectangle([k, k, w - 1 - k, h - 1 - k], outline=color)
+            tw = int(d.textlength(label, font=self._font))
+            pad = 9
+            x0, y0 = w - tw - 2 * pad - 12, box_h + 12
+            d.rectangle([x0, y0, x0 + tw + 2 * pad, y0 + 30], fill=color + (235,))
+            d.text((x0 + pad, y0 + 5), label, font=self._font, fill=(255, 255, 255, 255))
+
+        return np.asarray(pil)
+
+    # ------------------------------------------------------------------ 내부
+
+    def _write(self):
+        if self._renderer is None:
+            return
+        base = self.env.unwrapped
+        frames = []
+        for name in self._cameras:
+            try:
+                self._renderer.update_scene(base.data, camera=name)
+                frames.append(self._renderer.render())
+            except Exception:  # noqa: BLE001, S112
+                return
+        if not frames:
+            return
+        img = frames[0] if len(frames) == 1 else np.concatenate(frames, axis=1)
+        if self.hud:
+            try:
+                img = self._draw_hud(img)
+            except Exception:  # noqa: BLE001
+                pass
+
+        from PIL import Image
+
+        d = os.path.dirname(os.path.abspath(self.path)) or "."
+        fd, tmp = tempfile.mkstemp(dir=d, suffix=".jpg")
+        try:
+            with os.fdopen(fd, "wb") as f:
+                Image.fromarray(img).save(f, "JPEG", quality=self.quality)
+            # 읽는 쪽이 반쯤 쓰인 파일을 보지 않도록 원자적으로 교체한다.
+            os.replace(tmp, self.path)
+        except Exception:  # noqa: BLE001
+            if os.path.exists(tmp):
+                os.unlink(tmp)
+
+    def _maybe_pause(self):
+        """일시정지 파일이 있는 동안 여기서 멈춘다. 학습·연결은 그대로 살아 있다."""
+        if not self.pause_file:
+            return
+        try:
+            if not os.path.exists(self.pause_file):
+                if self._paused:
+                    self._paused = False
+                    logging.info("[view-stream] 재개한다.")
+                    self._write()
+                return
+        except OSError:
+            return
+        if not self._paused:
+            self._paused = True
+            logging.info(f"[view-stream] 일시정지 ({self.pause_file} 가 사라지면 재개).")
+            self._write()
+        t_pause = time.time()
+        while True:
+            try:
+                if not os.path.exists(self.pause_file):
+                    break
+            except OSError:
+                break
+            time.sleep(0.2)
+        self._paused = False
+        # 멈춰 있던 시간은 경과 시간에서 뺀다.
+        self._t0 += time.time() - t_pause
+        logging.info("[view-stream] 재개한다.")
+        self._write()
+
+    # ------------------------------------------------------------------ gym
+
+    def reset(self, **kwargs):
+        # 에피소드는 여기서 센다. 시간 초과(truncated)는 gym 환경이 아니라 그 바깥의
+        # lerobot 파이프라인(TimeLimitProcessorStep)이 판정하기 때문에, step() 의 반환값만
+        # 보고 있으면 시간 초과로 끝난 에피소드를 영영 못 센다(에피소드 번호가 1 에 멈춘다).
+        # 리셋이 곧 에피소드 종료이므로 그 순간에 센다.
+        if self._ep_step > 0:
+            ok = self._last_reward > 0.5
+            self._ep += 1
+            self._succ += int(ok)
+            self._recent.append(int(ok))
+            if len(self._recent) > 20:
+                self._recent.pop(0)
+        out = self.env.reset(**kwargs)
+        self._n = 0
+        self._ep_step = 0
+        self._last_reward = 0.0
+        self._intervening = False
+        self._write()
+        return out
+
+    def step(self, action):
+        self._maybe_pause()
+        out = self.env.step(action)
+        info = out[4] if len(out) >= 5 else {}
+        reward = float(out[1]) if len(out) >= 2 else 0.0
+        _ = out[2] if len(out) >= 3 else False  # terminated: reset() 에서 세므로 여기선 안 쓴다
+
+
+        self._steps += 1
+        self._ep_step += 1
+        self._n += 1
+        if isinstance(info, dict):
+            self._intervening = bool(info.get("is_intervention", False))
+            if self._intervening:
+                self._interv_steps += 1
+
+        # 성공 여부는 마지막 프레임의 보상으로 판정한다. 실제 집계는 reset() 에서 한다.
+        if reward > self._last_reward:
+            self._last_reward = reward
+
+        if self._n % self.every == 0:
+            self._write()
+
+        # 누적 경과 시간을 10초마다 파일에 남긴다. 다음 실행이 여기서 이어받는다.
+        if self._run_dir:
+            now = time.time()
+            if now - self._elapsed_saved_at > 10.0:
+                self._elapsed_saved_at = now
+                _save_elapsed(self._run_dir, self._elapsed_base + (now - self._t0))
+        return out
+
+    def close(self):
+        if getattr(self, "_run_dir", None):
+            _save_elapsed(self._run_dir, self._elapsed_base + (time.time() - self._t0))
+        if self._renderer is not None:
+            try:
+                self._renderer.close()
+            except Exception:  # noqa: BLE001, S110
+                pass
+            self._renderer = None
+        return self.env.close()
+
+
+def maybe_wrap_view_stream(env):
+    """HIL_VIEW_STREAM 이 설정돼 있으면 래퍼를 씌운다. 아니면 그대로 돌려준다."""
+    path = os.environ.get("HIL_VIEW_STREAM")
+    if not path:
+        return env
+    size = int(os.environ.get("HIL_VIEW_SIZE", "512"))
+    cameras = [c.strip() for c in os.environ.get("HIL_VIEW_CAMERAS", "front").split(",") if c.strip()]
+    every = int(os.environ.get("HIL_VIEW_EVERY", "1"))
+    hud = os.environ.get("HIL_VIEW_HUD", "1") not in ("0", "false", "off", "")
+    pause_file = os.environ.get("HIL_PAUSE_FILE", "/dev/shm/hil_pause")
+    return ViewStreamWrapper(env, path=path, size=size, cameras=cameras, every=every,
+                             hud=hud, pause_file=pause_file)
