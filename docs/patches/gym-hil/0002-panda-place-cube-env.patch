diff --git a/gym_hil/__init__.py b/gym_hil/__init__.py
index 8dd62e0..cd7c4bf 100644
--- a/gym_hil/__init__.py
+++ b/gym_hil/__init__.py
@@ -125,3 +125,76 @@ register(
         "use_inputs_control": True,
     },
 )
+
+
+# ---------------------------------------------------------------------------
+# PandaPlaceCube: 블록 하나를 집어서 바닥의 목표 패드 위에 내려놓는 태스크.
+# 이 값은 gymnasium 의 TimeLimit 상한이다. 실제 에피소드 길이는 lerobot 의
+# TimeLimitProcessorStep(control_time_s * fps) 이 정하므로, 여기서는 그보다 넉넉히
+# 잡아 두기만 한다. 2000 = 100초 @20fps. (600 으로 두었더니 control_time_s 를 40초로
+# 올려도 30초에서 잘렸다.)
+# ---------------------------------------------------------------------------
+
+register(
+    id="gym_hil/PandaPlaceCubeBase-v0",
+    entry_point="gym_hil.envs:PandaPlaceCubeGymEnv",
+    max_episode_steps=2000,
+)
+
+register(
+    id="gym_hil/PandaPlaceCubeViewer-v0",
+    entry_point=lambda **kwargs: PassiveViewerWrapper(gym.make("gym_hil/PandaPlaceCubeBase-v0", **kwargs)),
+    max_episode_steps=2000,
+)
+
+register(
+    id="gym_hil/PandaPlaceCube-v0",
+    entry_point="gym_hil.wrappers.factory:make_env",
+    max_episode_steps=2000,
+    kwargs={
+        "env_id": "gym_hil/PandaPlaceCubeBase-v0",
+        "use_inputs_control": False,
+        "gripper_penalty": -0.05,
+    },
+)
+
+# 조작용 기본 환경. MuJoCo 창을 띄우지 않는다.
+# VNC 의 GLX 가 소프트웨어라 창을 띄우면 스텝당 ~690 ms(1.5 fps)가 되기 때문이다.
+# 화면은 HIL_VIEW_STREAM 으로 내보내 브라우저에서 본다. MUJOCO_GL=egl 로 실행할 것.
+register(
+    id="gym_hil/PandaPlaceCubeKeyboard-v0",
+    entry_point="gym_hil.wrappers.factory:make_env",
+    max_episode_steps=2000,
+    kwargs={
+        "env_id": "gym_hil/PandaPlaceCubeBase-v0",
+        "use_viewer": False,
+        "gripper_penalty": -0.05,
+        "use_inputs_control": True,
+    },
+)
+
+# GPU GLX 가 있는 환경(로컬 데스크톱 등)에서 MuJoCo 창을 직접 띄우고 싶을 때 쓴다.
+register(
+    id="gym_hil/PandaPlaceCubeKeyboardWindow-v0",
+    entry_point="gym_hil.wrappers.factory:make_env",
+    max_episode_steps=2000,
+    kwargs={
+        "env_id": "gym_hil/PandaPlaceCubeBase-v0",
+        "use_viewer": True,
+        "gripper_penalty": -0.05,
+        "use_inputs_control": True,
+    },
+)
+
+register(
+    id="gym_hil/PandaPlaceCubeGamepad-v0",
+    entry_point="gym_hil.wrappers.factory:make_env",
+    max_episode_steps=2000,
+    kwargs={
+        "env_id": "gym_hil/PandaPlaceCubeBase-v0",
+        "use_viewer": True,
+        "gripper_penalty": -0.05,
+        "use_inputs_control": True,
+        "use_gamepad": True,
+    },
+)
